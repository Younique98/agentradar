DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=

# GitHub OAuth — required for anyone to sign in and leave a review. Every
# review is tied to the signed-in GitHub account (see
# src/pages/api/auth/[...nextauth].ts); there is no anonymous/free-text
# review path.
#
# Create a GitHub OAuth App at https://github.com/settings/developers
# ("New OAuth App"):
#   Homepage URL:             http://localhost:3000  (or your real domain)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Then copy the generated Client ID / Client Secret below. No scopes beyond
# the default read:user are requested — this app never touches repos.
GITHUB_ID=
GITHUB_SECRET=

# NextAuth's own session-signing secret (unrelated to GitHub). Generate one
# with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The deployed URL of this app, e.g. https://tooltest.co in production.
# Only required outside of localhost — NextAuth infers it from the request
# in dev.
# NEXTAUTH_URL=

# Stripe — powers the $9/mo Premium subscription (see src/utils/stripe.ts,
# src/pages/api/stripe/*, and
# migrations/0001_add_billing_and_featured_reviews.sql). Without these
# three set, the tool catalog and free-tier reviewing still work —
# /api/stripe/checkout just responds 503 until they're configured.
#
# 1. STRIPE_SECRET_KEY — Stripe Dashboard > Developers > API keys > Secret
#    key. Use a "sk_test_..." key while developing, "sk_live_..." in
#    production. Never commit a real value.
STRIPE_SECRET_KEY=
# 2. STRIPE_WEBHOOK_SECRET — Stripe Dashboard > Developers > Webhooks >
#    add an endpoint pointed at https://<your-domain>/api/stripe/webhook,
#    subscribed to checkout.session.completed, customer.subscription.updated,
#    and customer.subscription.deleted > Signing secret ("whsec_...").
#    For local testing, `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#    prints a signing secret to use here instead.
STRIPE_WEBHOOK_SECRET=
# 3. STRIPE_PRICE_ID — Stripe Dashboard > Product catalog > create a
#    recurring monthly Price on a "ToolTest Premium" product ("price_...").
#    Keep this in sync with PREMIUM_MONTHLY_PRICE_USD in
#    src/data/pricing.ts, which is display copy only and does not itself
#    control what's charged.
STRIPE_PRICE_ID=
